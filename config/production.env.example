# Never commit real secrets. Inject through your deployment secret manager.
AGENT_IDENTITY_SECRET=replace-with-a-32-byte-random-secret
UPSTREAM_MCP_URL=https://mcp.example.internal/mcp
MCP_SHARED_SECRET=replace-with-upstream-secret
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=10
MAX_REQUEST_BODY_BYTES=1048576
